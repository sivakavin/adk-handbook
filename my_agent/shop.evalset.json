{
  "eval_set_id": "shop_agent_sample_eval",
  "name": "Shop Agent Evaluation",
  "description": "Evaluates router hand-off to shop_agent, MCP tool selection/arguments (get_price, list_item) and final response correctness for the local shop server.",
  "eval_cases": [
    {
      "eval_id": "milk_price_test",
      "session_input": {
        "app_name": "my_agent",
        "user_id": "test_user_01",
        "state": {}
      },
      "conversation": [
        {
          "invocation_id": "milk_price_invocation_001",
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "What is the price of milk?"
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "transfer_to_agent",
                "args": {
                  "agent_name": "shop_agent"
                }
              },
              {
                "name": "get_price",
                "args": {
                  "item": "milk"
                }
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Milk is $50."
              }
            ]
          }
        }
      ]
    },
    {
